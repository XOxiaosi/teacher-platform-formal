generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            String   @id @default(cuid())
  teacherId     String
  name          String
  grade         String
  source        String?
  currentStatus String   @default("active") // active | paused | finished
  stageGoal     String?
  createdAtTs   DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs   DateTime @updatedAt @db.Timestamptz(3)

  schedules       Schedule[]
  lessons         Lesson[]
  payments        Payment[]
  parentFeedbacks ParentFeedback[]
  studentRecords  StudentRecord[]
  studentSourceRecords StudentSourceRecord[]
}

model Schedule {
  id               String   @id @default(cuid())
  teacherId        String
  studentId        String?
  type             String // lesson | prep | meeting | call | other
  title            String
  scheduledStartTs DateTime @db.Timestamptz(3)
  scheduledEndTs   DateTime @db.Timestamptz(3)
  status           String   @default("planned") // planned | completed | cancelled | missed | rescheduled | extra
  confidence       String? // high | medium | low
  pendingFields    Json?
  sourceInput      String?
  parentId         String?
  createdAtTs      DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs      DateTime @updatedAt @db.Timestamptz(3)

  student  Student?   @relation(fields: [studentId], references: [id])
  lessons  Lesson[]
  parent   Schedule?  @relation("ScheduleReschedule", fields: [parentId], references: [id])
  children Schedule[] @relation("ScheduleReschedule")

  @@index([studentId])
}

model Lesson {
  id           String   @id @default(cuid())
  teacherId    String
  studentId    String
  scheduleId   String
  dateTs       DateTime @db.Timestamptz(3)
  status       String   @default("pending") // attended | absent | pending
  progress     String?
  studentState String?
  homework     String?
  teacherNote  String?
  sourceNoteId String?
  createdAtTs  DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs  DateTime @updatedAt @db.Timestamptz(3)

  student         Student          @relation(fields: [studentId], references: [id])
  schedule        Schedule         @relation(fields: [scheduleId], references: [id])
  parentFeedbacks ParentFeedback[]

  @@index([studentId])
  @@index([studentId, status])
}

model AINote {
  id             String   @id @default(cuid())
  teacherId      String
  inputType      String // voice | text
  rawInput       String
  audioFileRef   String?
  intent         String? // schedule_create | schedule_modify | schedule_query | lesson_record | student_update | review_input | general_note
  extractedData  Json?
  confidence     String? // high | medium | low
  pendingFields  Json?
  routedTo       String?
  routedModuleId String?
  status         String   @default("pending") // processed | pending | failed
  createdAtTs    DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime @updatedAt @db.Timestamptz(3)
}

model Conversation {
  id          String   @id @default(cuid())
  teacherId   String
  status      String   @default("active") // active | archived
  summary     String?
  createdAtTs DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs DateTime @updatedAt @db.Timestamptz(3)

  turns          ConversationTurn[]
  pendingActions PendingAction[]
  executions     AgentExecution[]

  // 状态机：active -> archived
  // 归档后不可追加 turn
  // 归档不删除数据，只标记状态

}

model ConversationTurn {
  id             String   @id @default(cuid())
  conversationId String
  teacherId      String
  role           String // user | assistant | tool | error
  content        String
  toolCalls      Json?
  toolResults    Json?
  audioFileRef   String?
  createdAtTs    DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  // ConversationTurn 无 updatedAt：对话轮次是不可修改追加日志
  // 如需修正内容，只能追加新 turn，不修改历史 turn
  // role 允许：user | assistant | tool | error

  @@index([conversationId])
}

model AgentExecution {
  id                   String    @id @default(cuid())
  teacherId            String
  conversationId       String
  clientRequestId      String
  requestFingerprint   String
  userTurnId           String?   @unique
  status               String    @default("running") // running | succeeded | failed | partial | waiting_confirmation
  stage                String    @default("conversation") // conversation | model | tool | persistence | confirmation
  reply                String?
  error                Json?
  completedToolCallIds Json      @default("[]")
  startedAtTs          DateTime  @default(now()) @db.Timestamptz(3)
  finishedAtTs         DateTime? @db.Timestamptz(3)
  createdAtTs          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs          DateTime  @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([teacherId, clientRequestId])
  @@index([conversationId, createdAtTs])
}

model PendingAction {
  id             String    @id @default(cuid())
  teacherId      String
  conversationId String
  toolCallId     String
  actionName     String
  targetType     String
  targetId       String
  parameters     Json
  beforeSummary  String?
  afterSummary   String
  status         String    @default("pending") // pending | executing | consumed | cancelled | expired
  expiresAtTs    DateTime  @db.Timestamptz(3)
  consumedAtTs   DateTime? @db.Timestamptz(3)
  cancelledAtTs  DateTime? @db.Timestamptz(3)
  createdAtTs    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime  @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([teacherId, toolCallId])
  @@index([conversationId])
}

model Payment {
  id          String   @id @default(cuid())
  teacherId   String
  studentId   String
  amount      Float
  lessonCount Int
  paidAtTs    DateTime @db.Timestamptz(3)
  note        String?
  createdAtTs DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs DateTime @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model DailyReview {
  id                 String   @id @default(cuid())
  teacherId          String
  dateTs             DateTime @db.Date
  plannedCount       Int      @default(0)
  actualCount        Int      @default(0)
  cancelledCount     Int      @default(0)
  missedCount        Int      @default(0)
  rescheduledCount   Int      @default(0)
  pendingCount       Int      @default(0)
  deviations         Json?
  corrections        Json?
  tomorrowSuggestion String?
  createdAtTs        DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([teacherId, dateTs])
}

model PushRecord {
  id             String    @id @default(cuid())
  teacherId      String
  type           String // morning_brief | evening_review
  scheduledAtTs  DateTime  @db.Timestamptz(3)
  sentAtTs       DateTime? @db.Timestamptz(3)
  channel        String // wechat-bot | wecom | telegram
  content        String
  status         String    @default("pending") // pending | sent | failed | read
  errorMsg       String?
  createdAtTs    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status])
}

model ChangeLog {
  id          String   @id @default(cuid())
  teacherId   String
  timestampTs DateTime @default(now()) @db.Timestamptz(3)
  module      String
  action      String // create | update | delete | cancel | restore
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  diff        Json?
  source      String // ai-note | manual | system | push
  operatorId  String?
  createdAtTs DateTime @default(now()) @db.Timestamptz(3)

  @@index([module])
  @@index([targetType, targetId])
  @@index([timestampTs])
}

model Memo {
  id          String    @id @default(cuid())
  teacherId   String
  title       String
  content     String
  status      String    @default("active") // active | done | archived
  dueAtTs     DateTime? @db.Timestamptz(3)
  tags        Json?
  source      String?
  createdAtTs DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs DateTime  @updatedAt @db.Timestamptz(3)
}

model ParentFeedback {
  id         String    @id @default(cuid())
  teacherId  String
  studentId  String
  lessonId   String?
  title      String
  content    String
  status     String    @default("draft") // draft | reviewed | sent | archived
  channel    String? // wechat | phone | offline | other
  parentName String?
  sentAtTs    DateTime? @db.Timestamptz(3)
  moderationFlagged Boolean?
  moderationReasons Json?
  createdAtTs DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs DateTime  @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])
  contextSnapshot FeedbackContextSnapshot?

  @@index([studentId])
  @@index([lessonId])
}

// D40 学生长期资料库：原始证据
// 职责：记录某条学生信息从哪里来，不负责声明内容已经可信。
// 同一 (teacherId, sourceEntityType, sourceEntityId) 只允许捕获一次（幂等）；
// 手工/导入等无实体来源允许重复（NULL 不参与唯一约束）。
model StudentSourceRecord {
  id               String    @id @default(cuid())
  teacherId        String
  studentId        String?
  sourceType       String // agent_text | manual | lesson | assessment | audio | image | screenshot | import
  sourceEntityType String? // ConversationTurn | AINote | Lesson | MediaAsset | Upload
  sourceEntityId   String?
  occurredAtTs     DateTime  @db.Timestamptz(3)
  rawText          String?
  contentHash      String?
  captureStatus    String    @default("captured") // captured | unresolved | failed | archived
  createdAtTs      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs      DateTime  @updatedAt @db.Timestamptz(3)

  student Student?                 @relation(fields: [studentId], references: [id])
  records StudentRecord[]

  @@unique([teacherId, sourceEntityType, sourceEntityId])
  @@index([studentId])
}

// D40 学生长期资料库：学生长期时间线记录
// 统一承载老师可检索、可审核、可用于反馈的记录；summary 是事实摘要，不是对家长的话术。
model StudentRecord {
  id             String    @id @default(cuid())
  teacherId      String
  studentId      String
  sourceRecordId String?
  category       String // assessment | lesson_observation | parent_communication | learning_state | homework | goal | achievement | concern | agreement | follow_up | general_note
  occurredAtTs   DateTime  @db.Timestamptz(3)
  summary        String
  structuredData Json?
  confidence     String    @default("medium") // high | medium | low
  reviewStatus   String    @default("candidate") // candidate | confirmed | rejected | superseded
  visibility     String    @default("needs_review") // internal_only | parent_shareable | needs_review
  importance     String    @default("normal") // normal | important | critical
  supersedesId   String?
  createdAtTs    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime  @updatedAt @db.Timestamptz(3)

  student      Student?                 @relation(fields: [studentId], references: [id])
  sourceRecord StudentSourceRecord?     @relation(fields: [sourceRecordId], references: [id])
  supersedes   StudentRecord?           @relation("StudentRecordSupersede", fields: [supersedesId], references: [id])
  supersededBy StudentRecord[]          @relation("StudentRecordSupersede")
  assessment   AssessmentDetail?
  communicationDetail CommunicationDetail?

  @@index([studentId, occurredAtTs])
  @@index([sourceRecordId])
}

// D40 学生长期资料库：成绩结构
// 成绩必须可计算；只允许知道部分字段，未知值保持 null，不由模型补默认值。
model AssessmentDetail {
  id              String    @id @default(cuid())
  teacherId       String
  studentRecordId String    @unique
  examName        String?
  subject         String?
  examDateTs      DateTime? @db.Timestamptz(3)
  score           Float?
  fullScore       Float?
  classRank       Int?
  gradeRank       Int?
  percentile      Float?
  previousScore   Float?
  note            String?
  createdAtTs     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs     DateTime  @updatedAt @db.Timestamptz(3)

  studentRecord StudentRecord @relation(fields: [studentRecordId], references: [id])
}

// D40 学生长期资料库：家长沟通结构化
// "已经发生的沟通"明细，1:1 挂在 StudentRecord（category='parent_communication'）上；
// 与对外 ParentFeedback 草稿分开。方向/渠道/家长类型用注释枚举；列表字段为 jsonb 数组。
model CommunicationDetail {
  id               String    @id @default(cuid())
  teacherId        String
  studentRecordId  String    @unique
  direction        String // inbound | outbound | two_way
  channel          String? // phone | wechat | offline | other
  parentType       String? // normal | scores | sensitive（普通/只认分/玻璃心）
  parentConcerns   Json      @default("[]")
  teacherResponses Json      @default("[]")
  agreements       Json      @default("[]")
  followUps        Json      @default("[]")
  nextContactAtTs  DateTime? @db.Timestamptz(3)
  moderationFlagged Boolean?
  moderationReasons Json?
  createdAtTs      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs      DateTime  @updatedAt @db.Timestamptz(3)

  studentRecord StudentRecord @relation(fields: [studentRecordId], references: [id])
}

// D40 依据快照落库：把「生成反馈时引用的证据」永久存下来，历史反馈依据可还原。
// FeedbackContextSnapshot 1:1 挂在 ParentFeedback；FeedbackEvidence 是快照下的明细行。
// evidence 明细只来自已确认 + 可对外（confirmed + parent_shareable）的记录/课程。
model FeedbackContextSnapshot {
  id             String    @id @default(cuid())
  teacherId      String
  feedbackId     String    @unique
  windowStartTs  DateTime? @db.Timestamptz(3)
  windowEndTs    DateTime? @db.Timestamptz(3)
  assembledAtTs  DateTime  @db.Timestamptz(3) // 快照生成时刻（TrustedClock）
  createdAtTs    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime  @updatedAt @db.Timestamptz(3)

  feedback ParentFeedback @relation(fields: [feedbackId], references: [id])
  evidence FeedbackEvidence[]
}

model FeedbackEvidence {
  id             String    @id @default(cuid())
  teacherId      String
  snapshotId     String
  recordId       String? // 引用的源 StudentRecord id（若适用）
  type           String // assessment | record | lesson | media（media=多媒体证据，S3 线扩展）
  occurredAtTs   DateTime  @db.Timestamptz(3)
  category       String?
  summary        String?
  examName       String?
  subject        String?
  score          Float?
  fullScore      Float?
  previousScore  Float?
  parentConcerns Json      @default("[]")
  followUps      Json      @default("[]")
  mediaAssetId   String? // media 类型：引用的 MediaAsset（快照只引用不复制文件本体）
  sortOrder      Int
  createdAtTs    DateTime  @default(now()) @db.Timestamptz(3)

  snapshot FeedbackContextSnapshot @relation(fields: [snapshotId], references: [id])
}

// P7 认证地基：教师注册表（阶段一与业务表同库；数据库路由落地后再拆共享库）
// TeacherRegistry 自身无 teacherId 列：它是身份/租户的根，业务表才带 teacherId。
model TeacherRegistry {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  status       String   @default("active") // active | disabled
  databaseName String   @default("teacher_platform")
  createdAtTs  DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs  DateTime @updatedAt @db.Timestamptz(3)

  sessions SessionStore[]
  requirements UserRequirement[]
  providerConfigs ProviderConfig[]
  providerUsages ProviderUsage[]
  channelIdentities ChannelIdentity[]

  @@index([status])
}

// P7 认证地基：会话存储（token 只存哈希，不存明文）
model SessionStore {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  teacherId   String
  expiresAtTs DateTime @db.Timestamptz(3)
  createdAtTs DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs DateTime @updatedAt @db.Timestamptz(3)

  teacher TeacherRegistry @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

// P2 用户发言需求追溯（D50 §5.1）：共享库表，需求可回查原始对话/来源/时间戳，并与设计/任务/提交追溯。
// owner 语义：teacherId 可空（平台级/匿名需求无 owner）；有 owner 时按 owner 隔离（路由层校验）。
// verbatimQuote 不可修改（原话留证）；其余可编辑（PATCH 乐观锁 expectedUpdatedAt 复用 edit 模式）。
model UserRequirement {
  id             String   @id @default(cuid())
  teacherId      String? // 提出需求的教师（可空：平台级需求）
  verbatimQuote  String // 原话（不可修改，追溯留证）
  sourceType     String? // agent_conversation | wechat | manual | import | ...
  sourceDbName   String? // 来源库（教师库名）
  sourceTurnId   String? // 来源会话轮次 id
  contextSummary String? // 上下文摘要
  occurredAtTs   DateTime @db.Timestamptz(3) // 发言时间
  parsedIntent   String? // 解析意图
  category       String // 分类白名单（D51 §九）
  priority       String @default("normal") // low | normal | high | urgent
  status         String @default("new") // new | triaged | in_progress | done | archived
  linkedDesignDoc String? // 关联设计文档路径
  linkedTaskId   String? // 关联任务 id
  linkedCommitSha String? // 关联提交 sha
  moderationFlagged Boolean? // P14 D 切片：本地审核命中标记（review 心智——不阻断写库，人工复核依据）
  moderationReasons Json? // 命中原因（规则组 id + 中文描述数组，jsonb；未命中/未配置 null）
  createdAtTs    DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs    DateTime @updatedAt @db.Timestamptz(3)

  teacher TeacherRegistry? @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
  @@index([category])
}

// P7 渠道线：教师 LLM Provider 配置（D51 §五，t57 设计 §2.1）。共享库表——路由需在
// 访问教师库之前解析 provider；owner 隔离按 teacherId（requireAuth 后路由层强制）。
// apiKey 只存加密密文（apiKeyEnc，AES-256-GCM，密钥 env 注入），任何响应/日志不回明文。
model ProviderConfig {
  id           String   @id @default(cuid())
  teacherId    String // 归属教师（owner 隔离键）
  providerKind String // openai | anthropic（协议族）
  providerName String // deepseek | qwen | zhipu | ark | kimi | siliconflow | openrouter | anthropic ...
  displayName  String? // 教师自定义名（可空）
  baseUrl      String // 厂商 endpoint（不含 /chat/completions 后缀）
  apiKeyEnc    String // apiKey 加密存储（AES-256-GCM；禁明文）
  model        String // 主模型名（如 deepseek-chat）
  isPrimary    Boolean  @default(false) // 主 LLM 标记（每教师至多一个）
  status       String   @default("active") // active | disabled
  createdAtTs  DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs  DateTime @updatedAt @db.Timestamptz(3)

  teacher TeacherRegistry @relation(fields: [teacherId], references: [id])

  @@index([teacherId, isPrimary])
  @@index([teacherId, providerKind])
}

// P7 渠道线：Provider 用量追踪（t57 设计 §4）。共享库表（用量汇总按教师查询）。
// providerConfigId 无 FK（配置删除后置 null 保留用量，历史可追溯）；
// estimatedCostUsd 阶段一预留（单价表阶段二）；requestAt = 请求发生时刻（INSTANT/INPUT）。
model ProviderUsage {
  id               String   @id @default(cuid())
  teacherId        String
  providerConfigId String? // 关联配置（删除后置 null 保留用量）
  providerName     String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estimatedCostUsd Float? // 阶段一留空（单价表阶段二）
  conversationId   String?
  requestAt        DateTime @db.Timestamptz(3)
  createdAtTs      DateTime @default(now()) @db.Timestamptz(3)

  teacher TeacherRegistry @relation(fields: [teacherId], references: [id])

  @@index([teacherId, requestAt])
  @@index([providerConfigId])
}

// P8 微信接入线（t9，设计 p7-wechat-ilink-design.md §3/§8.2）：渠道身份绑定（共享库表）。
// 一微信号（externalUserId）至多绑定一个教师（@@unique([platform, externalUserId])）——
// 「一个微信号一个 Agent」；teacherId 索引保留（共享库多教师共存，R5 白名单表）。
// 解绑 = 删除行（unbind）；业务写入仍按 teacherId 校验（纵深防御）。
model ChannelIdentity {
  id                String   @id @default(cuid())
  teacherId         String // 归属教师（owner 隔离键）
  platform          String // 渠道平台：wechat（iLink 个人号）| 未来可扩展
  externalUserId    String // 微信侧用户标识（ilink_user_id / wxid）
  providerChannelId String? // 供应商渠道标识（ilink_bot_id；未获取时可空）
  createdAtTs       DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs       DateTime @updatedAt @db.Timestamptz(3)

  teacher TeacherRegistry @relation(fields: [teacherId], references: [id])

  @@unique([platform, externalUserId])
  @@index([teacherId])
}

// P8 微信接入线（t13，设计 p7-wechat-ilink-design.md §4/§8）：入站消息持久化（共享库表）。
// 幂等键：@@unique([channel, externalMessageId])——同一供应商消息重投只 claim 一行（重放防护持久层）；
// teacherId 可空：未绑定消息挂起（status='new' 不处理，绑定后由 S3 恢复扫描再处理）；
// processedAtTs 由服务层 TrustedClock 写入（业务时间纪律）；status: new | queued | processed | failed。
model ChannelMessage {
  id                 String    @id @default(cuid())
  teacherId          String? // 未绑定挂起为 null；绑定解析后填充
  channel            String // 渠道平台：wechat
  externalMessageId  String // 供应商消息 ID（幂等键）
  fromExternalUserId String // 发送方微信用户标识（ilink_user_id / wxid）
  toExternalUserId   String? // 接收方（bot/机器人标识；可空）
  direction          String    @default("inbound") // inbound（S2 仅入站）
  contentType        String    @default("text") // text（S2 仅文本；voice 等 S6）
  contentText        String // 消息文本（展示层/Agent 输入源）
  status             String    @default("new") // new | queued | processed | failed
  errorMsg           String? // 处理失败原因（Agent/出站失败记录；可重试依据）
  processedAtTs      DateTime? @db.Timestamptz(3) // TrustedClock 写入（处理完成时刻）
  createdAtTs        DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([channel, externalMessageId])
  @@index([teacherId, createdAtTs])
}

// P8 微信接入线（t23 S5，设计 p7-wechat-ilink-design.md §4.3）：渠道会话映射（共享库表）。
// 一教师多发送方（私聊=发送方 wxid；群聊=群 ID）→ 各自平台 Conversation（教师库）——
// S3 简化「复用首个 active Conversation」补全为按 externalConversationId 独立映射；
// lastMessageAtTs 由服务层 TrustedClock 写入（业务时间纪律）；@@unique([channel, teacherId, externalConversationId])。
model ChannelConversation {
  id                     String    @id @default(cuid())
  teacherId              String // 归属教师（owner 隔离键）
  channel                String // 渠道平台：wechat
  externalConversationId String // 外部会话标识（私聊=发送方 wxid；群聊=群 ID）
  conversationId         String // 平台 Conversation id（教师库）
  status                 String    @default("active") // active | archived
  lastMessageAtTs        DateTime? @db.Timestamptz(3) // TrustedClock 写入（最后消息时刻）
  createdAtTs            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAtTs            DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([channel, teacherId, externalConversationId])
  @@index([teacherId, status])
}

// P7 渠道线：后台管理员账号（t72 A6 阶段二，设计 §3.3）。共享库表（多管理员共存）。
// 阶段一认证仍走 env（ADMIN_EMAIL/ADMIN_PASSWORD_HASH），本表为阶段二账号管理落位（additive，不替换现状）。
model AdminAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // scrypt$salt$derived（与教师同算法/格式）
  status       String   @default("active") // active | disabled
  createdAtTs  DateTime @default(now()) @db.Timestamptz(3)
  updatedAtTs  DateTime @updatedAt @db.Timestamptz(3)
}

// P7 渠道线：管理员操作审计（t72 A6，设计 §5）。共享库表；只 append 不 update/delete（应用层纪律）。
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorEmail  String // 操作者（adminToken 会话 email）
  action      String // teacher.create / teacher.disable / backup.run / restore.run ...
  objectType  String // teacher / backup / system
  objectId    String?
  detail      Json?
  ip          String?
  createdAtTs DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorEmail, createdAtTs])
}

// P8 S3 多媒体证据链阶段一（p7-media-evidence-design.md §阶段一）+ 阶段二（§阶段二）：
// 媒体资产元数据。
// 原文件存 .data/media/<teacherId>/<assetId>/original（不入 git），DB 只存元数据 + 相对路径；
// 证据关联：StudentSourceRecord.sourceEntityType='MediaAsset'（复用既有 @@unique 幂等）；
// privacyLevel 保守默认 S1（含未成年影像/成绩截图/家庭沟通，PIPL 28 条）；scanStatus 阶段二启用病毒扫描（阶段一 skipped）。
// mediaType 与 StudentSourceRecord.sourceType 映射：image→image，screenshot→screenshot，audio→audio。
// 阶段二（t3）：encryptionVersion=文件级 AES-256-GCM 加密（MEDIA_ENCRYPTION_KEY 独立 env，与字段加密
// ENCRYPTION_KEY 分轨；null=阶段一遗留明文，读路径双读直通）；transcriptionStatus=ASR 转写状态占位
// （阶段三真实 ASR 接入，平台预配 shared/platform-services，不进教师配置）；orphanStatus/orphanMarkedAtTs=
// 孤儿回收标记（引用保护 + 保留期后清理，§6.2）。
// 阶段二续（t6）：transcriptionText=转写结果文本（占位：真实 ASR 阶段三接入）；transcriptionJobId=最近一次
// 转写作业的内存 jobId（background-jobs 心智，瞬态进度关联；DB transcriptionStatus 为权威状态）。
// P11 平台预配线 A2（OCR/MediaAnalysis）：ocrStatus=图片 OCR 状态占位流转（none|pending|completed|failed，
// 真实 OCR 阶段三-B 接入，平台预配 shared/platform-services，不进教师配置）；ocrText=OCR 识别文本；
// ocrLayoutBlocks=MediaAnalysis.layoutBlocks 输入（{text,bbox}[]，jsonb，区域证据 D40 §5.5）；
// ocrJobId=最近一次 OCR 作业的内存 jobId（同 transcriptionJobId 心智）。
model MediaAsset {
  id                   String    @id @default(cuid())
  teacherId            String // owner 隔离键
  mediaType            String // image | screenshot | audio | document
  sourceEntityType     String? // 预留：来源实体类型（如 ConversationTurn；阶段二）
  sourceEntityId       String? // 预留：来源实体 id（阶段二）
  sha256               String // 内容指纹（明文哈希；幂等去重键，加密不改变指纹语义）
  duplicateOf          String? // sha256 命中的已有资产 id（去重引用）
  mimeType             String // 服务端嗅探后的真实类型（不信客户端 Content-Type）
  sizeBytes            Int // 明文大小（加密前）
  privacyLevel         String    @default("S1") // S1 | S2 | S3（保守默认 S1）
  scanStatus           String    @default("skipped") // pending | clean | infected | error | skipped
  transcriptionStatus  String    @default("none") // none | pending | completed | failed（阶段三真实 ASR 占位流转）
  transcriptionText    String? // 转写结果文本（t6 占位；阶段三真实 ASR 结果写入）
  transcriptionJobId   String? // 最近转写作业 jobId（内存作业瞬态关联；重启即失效，以 DB 状态为准）
  ocrStatus            String    @default("none") // none | pending | completed | failed（阶段三-B 真实 OCR 占位流转）
  ocrText              String? // OCR 识别文本（P11 A2 占位；阶段三-B 真实 OCR 结果写入）
  ocrLayoutBlocks      Json? // MediaAnalysis.layoutBlocks 输入：{ text, bbox }[]（jsonb；区域证据 D40 §5.5）
  ocrJobId             String? // 最近 OCR 作业 jobId（内存作业瞬态关联；重启即失效，以 DB 状态为准）
  scanJobId            String? // 最近扫描作业 jobId（P12 A3/C 内存作业瞬态关联；重启即失效，以 DB 状态为准）
  scanThreatName       String? // infected 时命中威胁名（ScanResponse.threatName；管理端可查看，人工复核依据）
  encryptionVersion    String? // 'aes-256-gcm' | null（阶段二加密；null=阶段一明文遗留）
  orphanStatus         String    @default("active") // active | orphan（孤儿回收标记）
  orphanMarkedAtTs     DateTime? @db.Timestamptz(3) // 标记 orphan 时刻（TrustedClock；保留期从此刻起算）
  originalPath         String // 相对存储根路径：media/<teacherId>/<assetId>/original
  createdAtTs          DateTime  @default(now()) @db.Timestamptz(3)

  @@index([teacherId])
  @@index([sha256])
  @@index([orphanStatus, orphanMarkedAtTs])
}